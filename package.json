{
  "name": "mindmeter",
  "version": "0.1.0",
  "private": true,
  "description": "MindMeter M1: local-first assessment + user-provided LLM API",
  "scripts": {
    "test": "node scripts/test_prototype.js",
    "lint": "eslint scripts",
    "format": "prettier --write \"scripts/**/*.js\" \"*.{json,mjs}\"",
    "format:check": "prettier --check \"scripts/**/*.js\" \"*.{json,mjs}\"",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10"
  }
}
