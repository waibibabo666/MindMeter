{
  "name": "mindmeter",
  "version": "0.2.0",
  "private": true,
  "description": "MindMeter desktop: pywebview + FastAPI + local PostgreSQL + pgvector",
  "scripts": {
    "test": "npm run test:prototype && npm run test:app-shell && npm run test:memory && npm run test:report && npm run test:scoring && npm run test:agent && npm run test:kb && npm run test:units && npm run test:log && npm run test:chat",
    "test:prototype": "node scripts/test_prototype.js",
    "test:app-shell": "node scripts/test_app_shell.js",
    "test:report": "node scripts/test_report_trend.js",
    "test:units": "node scripts/test_units.js",
    "test:scoring": "node scripts/test_scoring.js",
    "test:agent": "node scripts/test_agent.js",
    "test:memory": "node scripts/test_memory.js",
    "test:kb": "node scripts/test_kb.js",
    "test:chat": "node scripts/test_chat.js",
    "test:log": "node scripts/test_log.js",
    "test:backend": "python -m pytest -q tests/backend -rs",
    "test:e2e": "playwright test",
    "lint": "eslint scripts code/frontend/src",
    "lint:frontend": "eslint code/frontend/src",
    "format": "prettier --write \"scripts/**/*.js\" \"code/frontend/**/*.{js,html,css}\" \"tests/e2e/**/*.js\" \"*.{json,mjs}\"",
    "format:check": "prettier --check \"scripts/**/*.js\" \"code/frontend/**/*.{js,html,css}\" \"tests/e2e/**/*.js\" \"*.{json,mjs}\"",
    "complexity": "eslint --config eslint.complexity.config.mjs scripts code/frontend/src",
    "check": "npm run lint && npm run format:check && npm run test"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "eslint": "^10.14.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.14.0",
    "prettier": "^3.9.10"
  }
}
