## 7. Agent Loop 参考实现

```ts
async function runAgent(task: Task, tools: Toolset, budget: Budget) {
  const msgs = [system(task), task.input];

  for (let step = 0; step < budget.maxSteps; step++) {
    const res = await callModel(msgs, tools.schema(), { timeout: 4000 });

    if (res.toolCalls?.length) {
      for (const call of res.toolCalls) {
        if (!tools.allowed(call.name)) {           // 白名单二次校验
          msgs.push(toolResult(call.id, { code: "not_allowed" }));
          continue;
        }
        const out = await tools.call(call.name, call.args, { timeout: 3000 });
        msgs.push(toolResult(call.id, out));
      }
      continue;
    }

    const draft = parse(res.content);
    const problems = validate(draft, { facts: task.facts, banned: task.banned });
    if (problems.length === 0) return ok(draft);

    msgs.push(fixHint(problems));                  // 校验失败回流为提示
  }
  return budget.exhausted();                       // 降级，不重试到底
}
```

要点：
- 步数硬上限，不靠模型自己说"我完成了"；
- 白名单在调用处再校验一次，防止模型伪造工具名；
- 校验失败转成可读 hint 回灌，这是唯一的自纠路径；
- 超时即降级，不排队等待。

